# Keep secrets and local files out of a public repository.
# Keys live in environment variables (see guide-environnement-etudiant-en.md).
# Copy this file to the root of your repository if that root is not kit-td1.
.env
.env.*
*.env
.envrc
*.key
*.pem
secrets*
credentials*
ready-for-td1.txt

# Virtual environments and Python caches
.venv/
venv/
__pycache__/
*.pyc

# Files regenerated when replaying the work (README, steps 2 and 3); the
# submitted results are the real traces, never replayed or simulated rows.
traces-replay.*
traces-demo.*
outils/references-all.csv

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
