# Raw traces are evidence: store them byte for byte, without line-ending conversion.
traces/** -text

# Data checked by fingerprint (data/manifest.json, schema.sql) and the result files
# regenerated by outils/: no line-ending conversion, or a Windows clone changes their
# bytes, verify-data.py fails and a regenerated file differs from the committed one.
data/** -text
schema.sql -text
*.csv -text
*.jsonl -text
*.json -text
